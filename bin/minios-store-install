#!/bin/sh
#
# MiniOS Store GTK3 Installer Launcher
# This script launches the MiniOS Store graphical installer
#

set -e

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: minios-store-install [uri | options]

Launch the MiniOS Store graphical installer.

Examples:
  minios-store-install "minios-store://install?mode=module&recipes=vlc:auto:zstd&packaging=single"
  minios-store-install --mode module --packaging single --recipes vlc:auto:zstd
EOF
        exit 0
        ;;
esac

SCRIPT_DIR=$(dirname "$(readlink -f -- "$0")")

if [ -d "$(dirname "$SCRIPT_DIR")/client" ]; then
    DIR="$(dirname "$SCRIPT_DIR")/client"
else
    DIR="/usr/lib/minios-store"
fi

exec python3 -c "
import sys
sys.path.insert(0, '$DIR')
from minios_store.gui import main
main()
" "$@"

#!/bin/sh
#
# MiniOS Store Daemon Launcher
# This script launches the MiniOS Store WebSocket daemon
#

set -e

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: minios-store-daemon [options]

Launch the MiniOS Store WebSocket daemon.

This command starts the local background service used by the MiniOS Store web
interface for installing recipes.
EOF
        exit 0
        ;;
esac

SCRIPT_DIR=$(dirname "$(readlink -f -- "$0")")

if [ -d "$(dirname "$SCRIPT_DIR")/client" ]; then
    DIR="$(dirname "$SCRIPT_DIR")/client"
else
    DIR="/usr/lib/minios-store"
fi

exec python3 -c "
import sys
sys.path.insert(0, '$DIR')
from minios_store.server import main
main()
" "$@"

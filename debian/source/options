# Exclude files not needed in the Debian source package.
#
# The .deb binary package only needs:
#   bin/               - daemon executable
#   client/            - Python backend
#   share/             - .desktop file, systemd/init.d service files
#   debian/            - packaging metadata
#   Makefile           - install target
#
# The web interface is hosted separately on GitHub Pages (store.minios.dev)
# and is not included in the .deb package.

# Web frontend (hosted separately on GitHub Pages, not included in .deb)
tar-ignore=web

# Recipe YAML sources (recipes.json is pre-built into web/dist/)
tar-ignore=recipes

# Build tools (not needed at runtime)
tar-ignore=tools

# Tests for excluded build tools are not part of the packaged Python suite
tar-ignore=tests/test_build_recipes.py
tar-ignore=tests/test_repo_parser.py

# CI/CD and git metadata
tar-ignore=.git
tar-ignore=.github
tar-ignore=.gitignore

# Documentation (not needed in package)
tar-ignore=README.md
tar-ignore=LICENSE

# Root package-lock.json (not used by the package)
tar-ignore=package-lock.json

# Python bytecode
tar-ignore=__pycache__
tar-ignore=.pytest_cache
tar-ignore=*.pyc
tar-ignore=*.pyo
tar-ignore=*$py.class
tar-ignore=.coverage
tar-ignore=htmlcov
tar-ignore=*.mo

# Debian staging and generated package state
tar-ignore=debian/.debhelper
tar-ignore=debian/debhelper-build-stamp
tar-ignore=debian/files
tar-ignore=debian/*.substvars
tar-ignore=debian/*.debhelper
tar-ignore=debian/*.log
tar-ignore=debian/minios-store
tar-ignore=debian/minios-store-common
tar-ignore=debian/minios-store-gui
tar-ignore=debian/tmp

# Package artifacts copied into the source root
tar-ignore=*.deb
tar-ignore=*.udeb
tar-ignore=*.build
tar-ignore=*.buildinfo
tar-ignore=*.changes
tar-ignore=*.dsc
tar-ignore=*.tar.*
